# PREPARAÇÃO SOMENTE. Não carregar no projeto real nesta etapa.
# Valores secretos ficam no gerenciador Supabase/cofre, nunca no frontend/Git.
SUPABASE_URL=https://pwbxksxxmnblqwpvlheu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Login por apelido; pepper mínimo de 32 caracteres, gerado só na ativação autorizada.
IASDPI_ALIAS_LOGIN_ENABLED=false
IASDPI_ALIAS_LOGIN_PEPPER=
IASDPI_ALIAS_ALLOWED_ORIGINS=

# Recuperação supervisionada e troca própria de senha.
IASDPI_GOVERNANCE_ENABLED=false
IASDPI_GOVERNANCE_PEPPER=
IASDPI_GOVERNANCE_ORIGINS=

# G11: só habilitar após 027, backend/frontend revisados e autorização.
IASDPI_ACCOUNT_CREATION_ENABLED=false
# Domínio institucional aprovado para quem não informa e-mail pessoal.
# Deixar vazio até confirmar o domínio; não inventar endereços de produção.
IASDPI_ACCOUNT_EMAIL_DOMAIN=

# Opcionais, somente se o gateway sobrescrever os headers e impedir falsificação:
# IASDPI_ALIAS_TRUSTED_IP_HEADER=
